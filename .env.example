# Copy to .env (local) or /etc/alfia-render-check.env (server) and fill in.
HOST=0.0.0.0
PORT=8080
# Long random secret; the same value goes in the API .env as GATES_RENDER_CHECK_TOKEN.
# Generate one with: openssl rand -hex 32
RENDER_CHECK_TOKEN=
# Pages rendered at the same time (each uses ~200–500 MB of memory).
MAX_CONCURRENCY=2
PAGE_TIMEOUT_MS=30000
MAX_PAGES=24
# Hosts the service may open. Keep this set in production.
ALLOWED_HOSTS=gate.alfia.com.sa,dev-gate.alfia.com.sa
